<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuizSync.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 历史：左边是会话列表，右边是该会话的题目。两边都从本地库读
         （`sessions` / `questions`，软删除的不显示）。 -->
    <Grid Background="{ThemeResource QsCanvasBrush}" RowDefinitions="*,Auto">
        <Border
            Grid.Row="0"
            Style="{StaticResource QsCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Width="720"
            Margin="0,24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock
                        Text="历史"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource QsOnSurfaceBrush}" />
                    <TextBlock
                        x:Name="HintText"
                        Style="{StaticResource QsSecondaryTextStyle}"
                        Text="点一条会话看当时识别出的题目。" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BodyPanel" Spacing="10" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <Button
                        x:Name="RefreshButton"
                        Content="刷新"
                        HorizontalAlignment="Stretch"
                        Click="OnRefreshClick" />
                    <HyperlinkButton Content="返回" HorizontalAlignment="Center" Click="OnBackClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource QsStatusBarBorderStyle}">
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource QsStatusTextStyle}"
                Text="正在读取本地记录…" />
        </Border>
    </Grid>
</Page>
