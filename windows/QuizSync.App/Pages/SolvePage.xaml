<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QuizSync.App.Pages.SolvePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 截屏搜题：Windows 侧的核心旅程。走的是已经端到端验证过的那条链
         （ScreenJpeg 截屏编码 → AnalysisEngine → 解析），与 `QuizSync.Provider.Cli analyze` 同一套代码。 -->
    <Grid Background="{ThemeResource QsCanvasBrush}" RowDefinitions="*,Auto">
        <Border
            Grid.Row="0"
            Style="{StaticResource QsCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Width="560"
            Margin="0,24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock
                        Text="截屏搜题"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource QsOnSurfaceBrush}" />
                    <TextBlock
                        x:Name="HintText"
                        Style="{StaticResource QsSecondaryTextStyle}"
                        Text="点下面的按钮，本窗口会先自动隐藏再截图，然后把答案显示在这里。" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultsPanel" Spacing="12" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <Button
                        x:Name="CaptureButton"
                        Content="截屏并识别"
                        Style="{StaticResource QsPrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnCaptureClick" />
                    <HyperlinkButton Content="返回" HorizontalAlignment="Center" Click="OnBackClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource QsStatusBarBorderStyle}">
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource QsStatusTextStyle}"
                Text="准备就绪" />
        </Border>
    </Grid>
</Page>
